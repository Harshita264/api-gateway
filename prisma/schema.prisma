generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RequestLog {
  id              Int       @id @default(autoincrement())
  method          String
  path            String
  statusCode      Int
  latencyMs       Int
  apiKey          String?
  upstreamUrl     String
  timestamp       DateTime @default(now())

  @@map("request_logs")
}

model ApiKey {
    id        Int       @id @default(autoincrement())
    key       String    @unique
    name      String
    isActive  Boolean   @default(true)
    createdAt DateTime  @default(now())

    @@map("api_keys")
}